<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="shopbee-product-service-1.0.0-1" author="shopbee">
        <createTable tableName="shopbee_product">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="price" type="numeric(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="sku" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(64)"/>
            <column name="updated_by" type="varchar(64)"/>
        </createTable>
    </changeSet>

    <changeSet id="shopbee-product-service-1.0.0-2" author="shopbee">
        <createTable tableName="shopbee_product_category">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="shopbee-product-service-1.0.0-3" author="shopbee">
        <addUniqueConstraint tableName="shopbee_product" columnNames="sku, tenant_id"
                             constraintName="unique_product_sku_tenant"/>
    </changeSet>

    <changeSet id="shopbee-product-service-1.0.0-4" author="shopbee">
        <addUniqueConstraint tableName="shopbee_product_category" columnNames="product_id, category_id, tenant_id"
                             constraintName="unique_product_category_product_category_tenant"/>
    </changeSet>

    <changeSet id="shopbee-product-service-1.0.0-5" author="shopbee">
        <createIndex tableName="shopbee_product_category" indexName="idx_product_category_product_id_tenant_id">
            <column name="product_id"/>
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="shopbee-product-service-1.0.0-6" author="shopbee">
        <createIndex tableName="shopbee_product_category" indexName="idx_product_category_category_id_tenant_id">
            <column name="category_id"/>
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

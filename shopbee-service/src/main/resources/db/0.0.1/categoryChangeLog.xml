<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="shopbee-category-service-1" author="shopbee">
        <createTable tableName="shopbee_category">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean"/>
        </createTable>
    </changeSet>

    <changeSet id="shopbee-category-service-2" author="shopbee">
        <addUniqueConstraint tableName="shopbee_category" columnNames="code, tenant_id"
                             constraintName="unique_category_code_tenant"/>
    </changeSet>

</databaseChangeLog>
